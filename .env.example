# PostgreSQL usado por Prisma. En local lo genera `pnpm infra:start`.
DATABASE_URL=

# Debe coincidir con `SHOW server_version` en el proyecto Supabase Cloud.
# No existe un valor por defecto deliberadamente.
SUPABASE_DB_MAJOR_VERSION=

# En local los genera `pnpm infra:start`. En producción deben venir del
# gestor de secretos del entorno.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

NODE_ENV=development
PORT=3000
