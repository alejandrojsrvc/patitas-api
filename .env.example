# PostgreSQL usado por Prisma. En local lo genera `pnpm infra:start`.
DATABASE_URL=

# Debe coincidir con `SHOW server_version` en el proyecto Supabase Cloud.
# No existe un valor por defecto deliberadamente.
SUPABASE_DB_MAJOR_VERSION=

# En local los genera `pnpm infra:start`. En producción deben venir del
# gestor de secretos del entorno.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000

# Pagos: `simulated` para diseño local; `mercadopago` exige las tres variables
# siguientes en el entorno seguro de la API.
PAYMENT_PROVIDER=simulated
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=

# Mensajería y marketing son noop por defecto. El scheduler externo usa CRON_SECRET.
NOTIFICATION_PROVIDER=noop
NOTIFICATION_PROVIDER_URL=
NOTIFICATION_PROVIDER_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_APP_URL=http://localhost:3000
MARKETING_PROVIDER=noop
MARKETING_PROVIDER_URL=
MARKETING_PROVIDER_TOKEN=
CRON_SECRET=
ABANDONED_CART_WINDOW_MINUTES=120
