# Copiar a .env.local y completar los valores locales.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_MAJOR_VERSION=17
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=local-publishable-key
SUPABASE_SECRET_KEY=local-secret-key
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000
PAYMENT_PROVIDERS=simulated
# Para probar Mercado Pago con una cuenta sandbox:
# PAYMENT_PROVIDERS=mercadopago,simulated
# MERCADOPAGO_PUBLIC_KEY=TEST-<public-key-de-la-cuenta-de-prueba>
# MERCADOPAGO_ACCESS_TOKEN=TEST-<access-token-de-la-cuenta-de-prueba>
# MERCADOPAGO_WEBHOOK_SECRET=<secreto-configurado-en-Mercado-Pago>
# MERCADOPAGO_NOTIFICATION_URL=https://<url-publica>/api/v1/payments/webhooks/mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
PAYWAY_SITE_ID=
PAYWAY_PUBLIC_API_KEY=
PAYWAY_PRIVATE_API_KEY=
# Base de API provista por Payway, por ejemplo la correspondiente a homologación.
PAYWAY_API_BASE_URL=
PAYWAY_NOTIFICATION_URL=
# Shared secret for the signed Payway webhook callback.
PAYWAY_WEBHOOK_SECRET=
NOTIFICATION_PROVIDER=noop
NOTIFICATION_PROVIDER_URL=
NOTIFICATION_PROVIDER_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_APP_URL=http://localhost:3000
MARKETING_PROVIDER=noop
MARKETING_PROVIDER_URL=
MARKETING_PROVIDER_TOKEN=
CRON_SECRET=
ABANDONED_CART_WINDOW_MINUTES=120
