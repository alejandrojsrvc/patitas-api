# ============================================================
# Patitas API - Plantilla de producción
# ============================================================
# No completar ni versionar secretos aquí.
# Guardar los valores reales en Vercel, GitHub Actions o el gestor de secretos.

# ------------------------------------------------------------
# Aplicación
# ------------------------------------------------------------
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://patitasinquietas.com.ar
PUBLIC_WEB_URL=https://patitasinquietas.com.ar

# ------------------------------------------------------------
# Neon PostgreSQL
# ------------------------------------------------------------
# DATABASE_URL: runtime de Vercel, conexión pooled.
# DIRECT_DATABASE_URL: migraciones y tareas operativas, conexión directa.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# ------------------------------------------------------------
# Cloudflare R2
# ------------------------------------------------------------
# R2 es el proveedor productivo. Usa una API compatible con S3 internamente.
# La credencial debe limitarse a product-media y payment-proofs.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.patitasinquietas.com.ar

# ------------------------------------------------------------
# Auth propio con JWT EdDSA
# ------------------------------------------------------------
# Claves Ed25519 en formato DER codificado como Base64.
# La clave privada sólo debe existir en el gestor de secretos.
AUTH_JWT_ISSUER=https://api.patitasinquietas.com.ar
AUTH_JWT_AUDIENCE=patitas-clients
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_EMAIL_CONFIRMATION_TTL_MINUTES=1440
AUTH_PASSWORD_RECOVERY_TTL_MINUTES=30

# ------------------------------------------------------------
# Cloudflare y protección antiabuso
# ------------------------------------------------------------
# Cloudflare debe inyectar X-Origin-Verify al origen y bloquear acceso directo.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_HOSTNAMES=patitasinquietas.com.ar,www.patitasinquietas.com.ar
ORIGIN_VERIFY_SECRET=

# ------------------------------------------------------------
# Jobs internos y cache
# ------------------------------------------------------------
CRON_SECRET=
CATALOG_EDGE_CACHE_ENABLED=false
VARNISH_PURGE_URL=http://patitas-varnish:6081/_cache/xkey
VARNISH_PURGE_SECRET=
# Opcionales: sólo si Cloudflare también almacena HTML.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=
ABANDONED_CART_WINDOW_MINUTES=120

# ------------------------------------------------------------
# Email transaccional
# ------------------------------------------------------------
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_APP_URL=https://patitasinquietas.com.ar

# ------------------------------------------------------------
# Marketing
# ------------------------------------------------------------
# Usar http sólo si también se configuran NOTIFICATION_PROVIDER_URL/TOKEN.
MARKETING_PROVIDER=noop

# ------------------------------------------------------------
# Mercado Pago
# ------------------------------------------------------------
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://api.patitasinquietas.com.ar/api/v1/payments/webhooks/mercadopago

# ------------------------------------------------------------
# Payway
# ------------------------------------------------------------
PAYWAY_SITE_ID=
PAYWAY_SITE_ID_VISA=
PAYWAY_SITE_ID_MASTERCARD=
PAYWAY_SITE_ID_AMERICAN_EXPRESS=
PAYWAY_SITE_ID_DISCOVER=
PAYWAY_SITE_ID_CABAL=
PAYWAY_PRIVATE_API_KEY=
PAYWAY_API_BASE_URL=https://ventasonline.payway.com.ar/api/v2
PAYWAY_WEBHOOK_SECRET=
