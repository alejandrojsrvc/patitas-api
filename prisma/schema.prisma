  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([type, active], map: "idx_operating_costs_type_active")
  @@map("operating_costs")
}

model PricingScenario {
  id                   String                      @id @default(uuid()) @db.Uuid
  name                 String
  periodStart          DateTime                    @map("period_start") @db.Timestamptz(6)
  periodEnd            DateTime                    @map("period_end") @db.Timestamptz(6)
  ordersSource         PricingScenarioOrdersSource @default(MANUAL) @map("orders_source")
  projectedOrders      Int                         @default(20) @map("projected_orders")
  averageItemsPerOrder Decimal                     @default(1) @map("average_items_per_order") @db.Decimal(8, 2)
  paymentFeeScheduleId String?                     @map("payment_fee_schedule_id") @db.Uuid
  active               Boolean                     @default(true)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
