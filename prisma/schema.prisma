  @@index([periodStart, periodEnd], map: "idx_pricing_scenarios_period")
  @@index([active, createdAt], map: "idx_pricing_scenarios_active_created")
  @@index([paymentFeeScheduleId], map: "idx_pricing_scenarios_payment_fee_schedule")
  @@map("pricing_scenarios")
}

model PricingReview {
  id               String              @id @default(uuid()) @db.Uuid
  variantId        String              @map("variant_id") @db.Uuid
  supplierOfferId  String              @map("supplier_offer_id") @db.Uuid
  pricingRuleSetId String              @map("pricing_rule_set_id") @db.Uuid
  status           PricingReviewStatus @default(PENDING)
  variantRevision  Int                 @map("variant_revision")
  supplierRevision Int                 @map("supplier_revision")
  inputSnapshot    Json                @map("input_snapshot")
  breakdown        Json
  recommendedPrice Decimal             @map("recommended_price") @db.Decimal(14, 2)
  commercialPrice  Decimal             @map("commercial_price") @db.Decimal(14, 2)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  appliedAt        DateTime?           @map("applied_at") @db.Timestamptz(6)
  variant          ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplierOffer    SupplierOffer       @relation(fields: [supplierOfferId], references: [id], onDelete: Restrict)
  pricingRuleSet   PricingRuleSet      @relation(fields: [pricingRuleSetId], references: [id], onDelete: Restrict)

  @@index([variantId, status], map: "idx_pricing_reviews_variant_status")
  @@map("pricing_reviews")
}

model ExternalIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
