  @@unique([provider, externalId], map: "payment_webhook_events_provider_external_key")
  @@index([status, createdAt], map: "idx_payment_webhook_events_status_created")
  @@index([status, processingStartedAt], map: "idx_payment_webhook_events_processing")
  @@index([paymentAttemptId, createdAt], map: "idx_payment_webhook_events_attempt_created")
  @@map("payment_webhook_events")
}

model ShippingZone {
