  order                 Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments              OrderPayment[]
  webhookEvents         PaymentWebhookEvent[]
  refunds               PaymentRefund[]

  @@index([orderId, createdAt], map: "idx_payment_attempts_order_created")
  @@index([provider, externalPaymentId], map: "idx_payment_attempts_provider_payment")
  @@index([provider, externalReference], map: "idx_payment_attempts_provider_reference")
  @@index([status, processingLeaseUntil], map: "idx_payment_attempts_processing_lease")
  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id                 String                    @id @default(uuid()) @db.Uuid
  provider           String
  externalId         String                    @map("external_id")
  eventType          String                    @map("event_type")
  externalPaymentId  String?                   @map("external_payment_id")
  externalReference  String?                   @map("external_reference")
  paymentAttemptId   String?                   @map("payment_attempt_id") @db.Uuid
  payload            Json
  processedAt        DateTime?                 @map("processed_at") @db.Timestamptz(6)
  processingStartedAt DateTime?                @map("processing_started_at") @db.Timestamptz(6)
  attemptCount       Int                       @default(0) @map("attempt_count")
  reconciliationRequired Boolean                @default(false) @map("reconciliation_required")
  reconciliationReason   String?                @map("reconciliation_reason")
  status             PaymentWebhookEventStatus @default(RECEIVED)
  error              String?
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
