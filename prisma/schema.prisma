  updatedAt DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([enabled, priority], map: "idx_payment_provider_configurations_enabled_priority")
  @@map("payment_provider_configurations")
}

model PaymentFeeSchedule {
  id               String             @id @default(uuid()) @db.Uuid
  provider         PaymentFeeProvider
  product          PaymentFeeProduct
  name             String
  settlementDays   Int                @map("settlement_days")
  feePercent       Decimal            @map("fee_percent") @db.Decimal(5, 2)
  vatApplies       Boolean            @default(true) @map("vat_applies")
  vatPercent       Decimal            @map("vat_percent") @db.Decimal(5, 2)
  fixedFee         Decimal            @default(0) @map("fixed_fee") @db.Decimal(14, 2)
  currency         String             @default("ARS") @db.VarChar(3)
  active           Boolean            @default(true)
  effectiveFrom    DateTime           @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo      DateTime?          @map("effective_to") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  pricingRuleSets  PricingRuleSet[]
  pricingScenarios PricingScenario[]

  @@unique([provider, product, settlementDays], map: "payment_fee_schedule_provider_product_days_key")
  @@index([provider, product, active], map: "idx_payment_fee_schedules_lookup")
  @@map("payment_fee_schedules")
}

model OperatingCost {
