// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SupplierOfferStockStatus {
  AVAILABLE
  OUT_OF_STOCK
  ON_REQUEST
  UNKNOWN
}

enum PricingRuleSetStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum PricingReviewStatus {
  PENDING
  APPLIED
  SUPERSEDED
}

enum PaymentFeeProvider {
  MERCADOPAGO
  PAYWAY
}

enum PaymentFeeProduct {
  CHECKOUT_PRO
}

enum OperatingCostType {
  FIXED_MONTHLY
  PER_ORDER
  PER_UNIT
  PERCENT_OF_SALE
}

enum PricingScenarioOrdersSource {
  MANUAL
  PREVIOUS_PERIOD
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PROCESSING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  CHARGED_BACK
}

enum InventoryMovementType {
  RESERVE
  RELEASE
  SHIP
  ADJUSTMENT
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
  EXPIRED
}

enum CheckoutStage {
  CONTACT
  SHIPPING
  PAYMENT
  CONFIRMATION
}

enum CheckoutStatus {
  DRAFT
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED
}

enum PromotionKind {
  DISCOUNT
  BUNDLE
}

enum ReplenishmentPlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  REPLIED
  CONVERTED
  FAILED
  CANCELLED
}

enum PaymentAttemptStatus {
  CREATED
  PROCESSING
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  CHARGED_BACK
}

enum OrderPaymentKind {
  PAYMENT
  REFUND
  CHARGEBACK
}

enum PaymentWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum PaymentRefundStatus {
  PROCESSING
  REFUNDED
  FAILED
}

enum PaymentProviderConfigurationName {
  SIMULATED
  MERCADO_PAGO
  PAYWAY
}

enum ShippingCoverageType {
  POSTAL_CODE
  NEIGHBORHOOD
  POLYGON
}

enum MarketingEventStatus {
  PENDING
  SENT
  FAILED
}

enum CatalogSourceStatus {
  SUCCESS
  PARTIAL
  BLOCKED
  ERROR
}

enum RetailPriceMatchStatus {
  MATCHED
  MISMATCH
  MISSING
  AMBIGUOUS
  BLOCKED
}

enum ReferralLedgerEntryType {
  CREDIT
  DEBIT
  REVERSAL
}

model Category {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique(map: "categories_slug_key")
  description      String?
  seoTitle         String?           @map("seo_title")
  seoDescription   String?           @map("seo_description")
  displayOrder     Int               @default(0) @map("display_order")
  parentId         String?           @map("parent_id") @db.Uuid
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products         Product[]
  promotionTargets PromotionTarget[]
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]        @relation("CategoryTree")

  @@index([active], map: "idx_categories_active")
  @@index([parentId], map: "idx_categories_parent_id")
  @@map("categories")
}

model Brand {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique(map: "brands_slug_key")
  description      String?
  seoTitle         String?           @map("seo_title")
  seoDescription   String?           @map("seo_description")
  logoUrl          String?           @map("logo_url")
  displayOrder     Int               @default(0) @map("display_order")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products         Product[]
  promotionTargets PromotionTarget[]

  @@index([active], map: "idx_brands_active")
  @@map("brands")
}

model Product {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String                    @unique(map: "products_slug_key")
  description              String?
  ingredientsText          String?                   @map("ingredients_text")
  analyticalComposition    Json?                     @map("analytical_composition")
  brandId                  String                    @map("brand_id") @db.Uuid
  categoryId               String?                   @map("category_id") @db.Uuid
  line                     String?
  species                  String?
  lifeStage                String?                   @map("life_stage")
  breedSize                String?                   @map("breed_size")
  estimatedDailyGramsPerKg Decimal?                  @map("estimated_daily_grams_per_kg")
  featuredRank             Int?                      @map("featured_rank")
  status                   ProductStatus             @default(DRAFT)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variants                 ProductVariant[]
  brand                    Brand                     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category                 Category?                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media                    ProductMedia[]
  feedingGuides            FeedingGuide[]
  sourceSnapshots          ProductSourceSnapshot[]
  promotionTargets         PromotionTarget[]
  viewDaily                ProductViewDaily[]
  viewVisitors             ProductViewVisitorDaily[]
  recentViews              RecentProductView[]
  replenishmentEstimates   ReplenishmentEstimate[]
  replenishmentPlans       ReplenishmentPlan[]

  @@index([brandId], map: "idx_products_brand_id")
  @@index([categoryId], map: "idx_products_category_id")
  @@index([species], map: "idx_products_species")
  @@index([status], map: "idx_products_status")
  @@map("products")
}

model ProductVariant {
  id                       String                   @id @default(uuid()) @db.Uuid
  productId                String                   @map("product_id") @db.Uuid
  sku                      String?                  @unique(map: "product_variants_sku_key")
  barcode                  String?                  @unique(map: "product_variants_barcode_key")
  presentation             String?
  weightGrams              Int?                     @map("weight_grams")
  salePrice                Decimal?                 @map("sale_price") @db.Decimal(14, 2)
  compareAtPrice           Decimal?                 @map("compare_at_price") @db.Decimal(14, 2)
  active                   Boolean                  @default(true)
  preferredSupplierOfferId String?                  @unique(map: "product_variants_preferred_offer_key") @map("preferred_supplier_offer_id") @db.Uuid
  revision                 Int                      @default(1)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product                  Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierOffers           SupplierOffer[]          @relation("VariantSupplierOffers")
  preferredSupplierOffer   SupplierOffer?           @relation("PreferredSupplierOffer", fields: [preferredSupplierOfferId], references: [id], onDelete: SetNull)
  pricingReviews           PricingReview[]
  retailPriceObservations  RetailPriceObservation[]
  inventory                InventoryItem?
  media                    ProductMedia[]
  orderLines               OrderLine[]
  inventoryMovements       InventoryMovement[]
  cartItems                CartItem[]
  promotionTargets         PromotionTarget[]
  bundleItems              PromotionBundleItem[]
  replenishmentEstimates   ReplenishmentEstimate[]
  replenishmentPlans       ReplenishmentPlan[]

  @@unique([productId, weightGrams], map: "product_variants_product_id_weight_grams_key")
  @@unique([id, productId], map: "product_variants_id_product_id_key")
  @@index([productId], map: "idx_product_variants_product_id")
  @@index([active], map: "idx_product_variants_active")
  @@map("product_variants")
}

model ProductMedia {
  id           String          @id @default(uuid()) @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  variantId    String?         @map("variant_id") @db.Uuid
  url          String
  altText      String          @map("alt_text")
  displayOrder Int             @default(0) @map("display_order")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)

  @@index([productId, displayOrder], map: "idx_product_media_product_order")
  @@map("product_media")
}

model FeedingGuide {
  id                 String              @id @default(uuid()) @db.Uuid
  productId          String              @map("product_id") @db.Uuid
  sourceLabel        String              @map("source_label")
  sourceUrl          String?             @map("source_url")
  version            Int                 @default(1)
  requiredDimensions Json?               @map("required_dimensions")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  entries            FeedingGuideEntry[]

  @@unique([productId, version], map: "feeding_guides_product_version_key")
  @@index([productId, active], map: "idx_feeding_guides_product_active")
  @@map("feeding_guides")
}

model FeedingGuideEntry {
  id             String       @id @default(uuid()) @db.Uuid
  feedingGuideId String       @map("feeding_guide_id") @db.Uuid
  petWeightKgMin Decimal      @map("pet_weight_kg_min") @db.Decimal(7, 2)
  petWeightKgMax Decimal?     @map("pet_weight_kg_max") @db.Decimal(7, 2)
  lifeStage      String?      @map("life_stage")
  conditions     Json?
  dailyGramsMin  Decimal      @map("daily_grams_min") @db.Decimal(8, 2)
  dailyGramsMax  Decimal?     @map("daily_grams_max") @db.Decimal(8, 2)
  feedingGuide   FeedingGuide @relation(fields: [feedingGuideId], references: [id], onDelete: Cascade)

  @@index([feedingGuideId, petWeightKgMin], map: "idx_feeding_entries_guide_weight")
  @@map("feeding_guide_entries")
}

model ProductSourceSnapshot {
  id               String              @id @default(uuid()) @db.Uuid
  productId        String              @map("product_id") @db.Uuid
  sourceType       String              @map("source_type")
  sourceUrl        String              @map("source_url")
  fetchedAt        DateTime            @map("fetched_at") @db.Timestamptz(6)
  contentHash      String              @map("content_hash")
  extractorVersion String              @map("extractor_version")
  status           CatalogSourceStatus
  payload          Json?
  warnings         Json?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, contentHash], map: "product_source_snapshots_product_hash_key")
  @@index([productId, fetchedAt], map: "idx_product_source_snapshots_product_fetched")
  @@map("product_source_snapshots")
}

model RetailPriceObservation {
  id                String                 @id @default(uuid()) @db.Uuid
  variantId         String                 @map("variant_id") @db.Uuid
  retailerCode      String                 @map("retailer_code")
  sourceUrl         String                 @map("source_url")
  externalProductId String?                @map("external_product_id")
  externalVariantId String?                @map("external_variant_id")
  titleSnapshot     String?                @map("title_snapshot")
  weightGrams       Int?                   @map("weight_grams")
  bonusWeightGrams  Int?                   @map("bonus_weight_grams")
  price             Decimal?               @db.Decimal(14, 2)
  listPrice         Decimal?               @map("list_price") @db.Decimal(14, 2)
  currency          String                 @default("ARS") @db.VarChar(3)
  availability      String                 @default("UNKNOWN")
  priceCondition    String?                @map("price_condition")
  matchStatus       RetailPriceMatchStatus @map("match_status")
  warnings          Json?
  runId             String                 @map("run_id")
  observedAt        DateTime               @map("observed_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  variant           ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, retailerCode, observedAt], map: "idx_retail_price_observations_variant_retailer_date")
  @@index([retailerCode, observedAt], map: "idx_retail_price_observations_retailer_date")
  @@index([runId], map: "idx_retail_price_observations_run_id")
  @@map("retail_price_observations")
}

model InventoryItem {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @unique(map: "inventory_items_variant_key") @map("variant_id") @db.Uuid
  onHand    Int            @default(0) @map("on_hand")
  reserved  Int            @default(0)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique(map: "users_email_key") @db.VarChar(320)
  role               UserRole            @default(CUSTOMER)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  externalIdentities ExternalIdentity[]
  customer           Customer?
  auditLogs          AdminAuditLog[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

model Supplier {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  offers    SupplierOffer[]

  @@index([active], map: "idx_suppliers_active")
  @@map("suppliers")
}

model SupplierOffer {
  id              String                   @id @default(uuid()) @db.Uuid
  supplierId      String                   @map("supplier_id") @db.Uuid
  variantId       String                   @map("variant_id") @db.Uuid
  supplierSku     String?                  @map("supplier_sku")
  unitCost        Decimal                  @map("unit_cost") @db.Decimal(14, 2)
  currency        String                   @default("ARS") @db.VarChar(3)
  stockStatus     SupplierOfferStockStatus @default(UNKNOWN) @map("stock_status")
  leadTimeHours   Int?                     @map("lead_time_hours")
  minimumQuantity Int                      @default(1) @map("minimum_quantity")
  active          Boolean                  @default(true)
  revision        Int                      @default(1)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  supplier        Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  variant         ProductVariant           @relation("VariantSupplierOffers", fields: [variantId], references: [id], onDelete: Cascade)
  preferredBy     ProductVariant?          @relation("PreferredSupplierOffer")
  pricingReviews  PricingReview[]

  @@unique([supplierId, variantId], map: "supplier_offers_supplier_variant_key")
  @@index([variantId], map: "idx_supplier_offers_variant_id")
  @@map("supplier_offers")
}

model Customer {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String?                @unique @map("user_id") @db.Uuid
  fullName               String                 @map("full_name")
  email                  String                 @db.VarChar(320)
  phone                  String?
  active                 Boolean                @default(true)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders                 Order[]
  addresses              CustomerAddress[]
  carts                  Cart[]
  checkoutSessions       CheckoutSession[]
  couponRedemptions      CouponRedemption[]
  recentViews            RecentProductView[]
  replenishmentPlans     ReplenishmentPlan[]
  pets                   Pet[]
  replenishmentEstimates ReplenishmentEstimate[]
  communicationConsents  CommunicationConsent[]
  notificationPreference CustomerNotificationPreference?
  deviceTokens           DeviceToken[]
  marketingEvents        MarketingEvent[]
  notificationDeliveries NotificationDelivery[]
  referralCodes          ReferralCode[]
  referredAttributions   ReferralAttribution[]
  referralLedgerEntries  ReferralLedgerEntry[]

  @@index([email], map: "idx_customers_email")
  @@index([active], map: "idx_customers_active")
  @@map("customers")
}

model Order {
  id                    String                 @id @default(uuid()) @db.Uuid
  customerId            String?                @map("customer_id") @db.Uuid
  status                OrderStatus            @default(DRAFT)
  paymentStatus         PaymentStatus          @default(UNPAID) @map("payment_status")
  paymentMethod         String?                @map("payment_method")
  paymentReference      String?                @map("payment_reference")
  paymentProvider       String?                @map("payment_provider")
  paymentExternalId     String?                @map("payment_external_id")
  paymentExpiresAt      DateTime?              @map("payment_expires_at") @db.Timestamptz(6)
  reservationExpiresAt  DateTime?              @map("reservation_expires_at") @db.Timestamptz(6)
  reservationReleasedAt DateTime?             @map("reservation_released_at") @db.Timestamptz(6)
  reconciliationRequired Boolean               @default(false) @map("reconciliation_required")
  reconciliationReason String?                 @map("reconciliation_reason")
  currency              String                 @default("ARS") @db.VarChar(3)
  subtotal              Decimal                @db.Decimal(14, 2)
  shippingCost          Decimal                @default(0) @map("shipping_cost") @db.Decimal(14, 2)
  shippingProviderCost  Decimal                @default(0) @map("shipping_provider_cost") @db.Decimal(14, 2)
  shippingSubsidy       Decimal                @default(0) @map("shipping_subsidy") @db.Decimal(14, 2)
  shippingDeliveryCount Int                    @default(0) @map("shipping_delivery_count")
  shippingVat           Decimal                @default(0) @map("shipping_vat") @db.Decimal(14, 2)
  shippingDeliverySlot  String?               @map("shipping_delivery_slot")
  shippingDeliveryDate  DateTime?             @map("shipping_delivery_date") @db.Date
  total                 Decimal                @db.Decimal(14, 2)
  discountTotal         Decimal                @default(0) @map("discount_total") @db.Decimal(14, 2)
  couponCode            String?                @map("coupon_code")
  shippingOptionId      String?                @map("shipping_option_id") @db.Uuid
  shippingMethod        String?                @map("shipping_method")
  shippingZoneId        String?                @map("shipping_zone_id") @db.Uuid
  shippingEstimate      String?                @map("shipping_estimate")
  publicAccessTokenHash String?                @unique(map: "orders_public_access_token_key") @map("public_access_token_hash")
  contactName           String                 @map("contact_name")
  contactEmail          String                 @map("contact_email") @db.VarChar(320)
  contactPhone          String?                @map("contact_phone")
  shippingAddress       Json                   @map("shipping_address")
  notes                 String?
  trackingNumber        String?                @map("tracking_number")
  utmSource             String?                @map("utm_source")
  utmMedium             String?                @map("utm_medium")
  utmCampaign           String?                @map("utm_campaign")
  utmContent            String?                @map("utm_content")
  initialLanding        String?                @map("initial_landing")
  anonymousVisitorHash  String?                @map("anonymous_visitor_hash")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer              Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines                 OrderLine[]
  payments              OrderPayment[]
  inventoryMoves        InventoryMovement[]
  shippingOption        ShippingOption?        @relation(fields: [shippingOptionId], references: [id], onDelete: SetNull)
  checkoutSession       CheckoutSession?
  replenishmentPlans    ReplenishmentPlan[]
  paymentAttempts       PaymentAttempt[]
  refunds               PaymentRefund[]
  couponRedemptions     CouponRedemption[]
  convertedCart         Cart?                  @relation("CartConvertedOrder")
  shippingZone          ShippingZone?          @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  notifications         NotificationDelivery[]
  marketingEvents       MarketingEvent[]
  referralLedgerEntries ReferralLedgerEntry[]
  referralAttributions  ReferralAttribution[]

  @@index([status, createdAt], map: "idx_orders_status_created")
  @@index([customerId], map: "idx_orders_customer_id")
  @@map("orders")
}

model OrderLine {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  variantId    String         @map("variant_id") @db.Uuid
  productName  String         @map("product_name")
  sku          String?
  presentation String?
  unitPrice    Decimal        @map("unit_price") @db.Decimal(14, 2)
  quantity     Int
  lineTotal    Decimal        @map("line_total") @db.Decimal(14, 2)
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_order_lines_order_id")
  @@index([variantId], map: "idx_order_lines_variant_id")
  @@map("order_lines")
}

model OrderPayment {
  id                  String               @id @default(uuid()) @db.Uuid
  orderId             String               @map("order_id") @db.Uuid
  paymentAttemptId    String?              @map("payment_attempt_id") @db.Uuid
  amount              Decimal              @db.Decimal(14, 2)
  currency            String               @default("ARS") @db.VarChar(3)
  kind                OrderPaymentKind     @default(PAYMENT)
  provider            String?
  externalPaymentId  String?              @map("external_payment_id")
  externalOperationId String?              @map("external_operation_id")
  method              String
  reference           String?
  proofUrl            String?              @map("proof_url")
  paidAt             DateTime?            @map("paid_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttempt     PaymentAttempt?      @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt], map: "idx_order_payments_order_created")
  @@index([paymentAttemptId, createdAt], map: "idx_order_payments_attempt_created")
  @@map("order_payments")
}

model PaymentRefund {
  id                 String             @id @default(uuid()) @db.Uuid
  orderId            String             @map("order_id") @db.Uuid
  paymentAttemptId   String?            @map("payment_attempt_id") @db.Uuid
  provider           String
  externalPaymentId String             @map("external_payment_id")
  externalOperationId String?           @unique @map("external_operation_id")
  amount             Decimal            @db.Decimal(14, 2)
  currency           String             @db.VarChar(3)
  idempotencyKey     String             @unique @map("idempotency_key")
  status             PaymentRefundStatus @default(PROCESSING)
  failureReason     String?             @map("failure_reason")
  rawResponse       Json?               @map("raw_response")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttempt    PaymentAttempt?     @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

