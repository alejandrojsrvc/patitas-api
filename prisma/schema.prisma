  @@map("referral_campaigns")
}

model ReferralCode {
  id            String                @id @default(uuid()) @db.Uuid
  campaignId    String                @map("campaign_id") @db.Uuid
  referrerId    String                @map("referrer_id") @db.Uuid
  code          String                @unique
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign      ReferralCampaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  referrer      Customer              @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  attributions  ReferralAttribution[]
  ledgerEntries ReferralLedgerEntry[]

  @@index([referrerId, active], map: "idx_referral_codes_referrer_active")
  @@map("referral_codes")
}

model ReferralAttribution {
  id             String       @id @default(uuid()) @db.Uuid
  referralCodeId String       @map("referral_code_id") @db.Uuid
  referredId     String       @map("referred_id") @db.Uuid
  orderId        String?      @unique @map("order_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  referred       Customer     @relation(fields: [referredId], references: [id], onDelete: Cascade)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([referralCodeId, referredId], map: "referral_attributions_code_referred_key")
  @@map("referral_attributions")
}

model ReferralLedgerEntry {
  id              String                  @id @default(uuid()) @db.Uuid
  customerId      String                  @map("customer_id") @db.Uuid
  referralCodeId  String?                 @map("referral_code_id") @db.Uuid
  orderId         String?                 @map("order_id") @db.Uuid
  type            ReferralLedgerEntryType
  amount          Decimal                 @db.Decimal(14, 2)
  reason          String
  expiresAt       DateTime?               @map("expires_at") @db.Timestamptz(6)
  reversedEntryId String?                 @unique @map("reversed_entry_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  customer        Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  referralCode    ReferralCode?           @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  order           Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reversedEntry   ReferralLedgerEntry?    @relation("ReferralLedgerReversal", fields: [reversedEntryId], references: [id], onDelete: SetNull)
  reversal        ReferralLedgerEntry?    @relation("ReferralLedgerReversal")

  @@index([customerId, expiresAt], map: "idx_referral_ledger_customer_expiry")
  @@map("referral_ledger_entries")
}

model PricingRuleSet {
  id                     String               @id @default(uuid()) @db.Uuid
  version                Int                  @unique
  status                 PricingRuleSetStatus @default(DRAFT)
  currency               String               @default("ARS") @db.VarChar(3)
  fulfillmentCost        Decimal?             @map("fulfillment_cost") @db.Decimal(14, 2)
  packagingCost          Decimal?             @map("packaging_cost") @db.Decimal(14, 2)
  paymentFixedCost       Decimal?             @map("payment_fixed_cost") @db.Decimal(14, 2)
  paymentFeePercent      Decimal?             @map("payment_fee_percent") @db.Decimal(5, 2)
  paymentFeeVatApplies   Boolean?             @map("payment_fee_vat_applies")
  paymentFeeVatPercent   Decimal?             @map("payment_fee_vat_percent") @db.Decimal(5, 2)
  paymentFeeScheduleId   String?              @map("payment_fee_schedule_id") @db.Uuid
  subsidizedShippingCost Decimal?             @map("subsidized_shipping_cost") @db.Decimal(14, 2)
  taxPercent             Decimal?             @map("tax_percent") @db.Decimal(5, 2)
  otherCost              Decimal?             @map("other_cost") @db.Decimal(14, 2)
  targetMarginPercent    Decimal?             @map("target_margin_percent") @db.Decimal(5, 2)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
