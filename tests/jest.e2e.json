{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/tests/e2e/**/*.spec.ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)sx?$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  }
}
